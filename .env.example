# ZERO Configuration
# Copy this file to .env and fill in your values.
# DO NOT COMMIT .env TO VERSION CONTROL.

# LLM Configuration (Groq - Recommended)
# Get your key at https://console.groq.com/keys
# If ZERO_GROQ_API_KEY is set, it will be used by default.
ZERO_GROQ_API_KEY=gsk_...
ZERO_MODEL=openai/gpt-oss-120b

# LLM Configuration (Ollama - Alternative)
# ZERO_OLLAMA_HOST=http://localhost:11434
# ZERO_MODEL=llama3.2
# ZERO_API_KEY=ignore


# Notion Integration (Ops-0)
# Create an integration at https://www.notion.so/my-integrations
# Internal Integration Token
ZERO_NOTION_KEY=secret_...

# GitHub Integration (Dev-0)
# Personal Access Token (Classic) with 'repo' scope
ZERO_GITHUB_KEY=ghp_...

# Trello Integration (Ops-0)
# Get Key: https://trello.com/app-key
# Get Token: https://trello.com/1/authorize?expiration=never&scope=read,write,account&response_type=token&key=YOUR_KEY
ZERO_TRELLO_KEY=your_key
ZERO_TRELLO_TOKEN=your_token